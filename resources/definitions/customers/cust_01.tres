[gd_resource type="Resource" script_class="CustomerDefinition" format=3]

[ext_resource type="Script" path="res://resources/definitions/order_template.gd" id="1_tpl"]
[ext_resource type="Resource" path="res://resources/definitions/items/iron_ingot.tres" id="2_ingot"]
[ext_resource type="Resource" path="res://resources/definitions/items/iron_plate.tres" id="3_plate"]
[ext_resource type="Script" path="res://resources/definitions/customer_definition.gd" id="4_cust"]
[ext_resource type="Texture2D" path="res://resources/sprites/portraits/customer_01.png" id="5_sprite"]

[sub_resource type="Resource" id="Resource_ingot"]
script = ExtResource("1_tpl")
item = ExtResource("2_ingot")
weight = 3
max_quantity = 3

[sub_resource type="Resource" id="Resource_plate"]
script = ExtResource("1_tpl")
item = ExtResource("3_plate")

[resource]
script = ExtResource("4_cust")
id = "cust_01"
name = "Brom"
role = "Village Smith"
sprite = ExtResource("5_sprite")
max_orders = 2
wants = Array[ExtResource("1_tpl")]([SubResource("Resource_ingot"), SubResource("Resource_plate")])
