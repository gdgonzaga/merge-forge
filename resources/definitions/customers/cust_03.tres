[gd_resource type="Resource" script_class="CustomerDefinition" format=3]

[ext_resource type="Script" path="res://resources/definitions/order_template.gd" id="1_tpl"]
[ext_resource type="Resource" path="res://resources/definitions/items/iron_plate.tres" id="2_plate"]
[ext_resource type="Resource" path="res://resources/definitions/items/herbal_tonic.tres" id="3_tonic"]
[ext_resource type="Resource" path="res://resources/definitions/items/iron_ingot.tres" id="4_ingot"]
[ext_resource type="Script" path="res://resources/definitions/customer_definition.gd" id="5_cust"]
[ext_resource type="Texture2D" path="res://resources/sprites/portraits/customer_03.png" id="6_sprite"]

[ext_resource type="Script" path="res://resources/definitions/loyalty_reward.gd" id="p7_loyalty"]
[ext_resource type="Resource" path="res://resources/definitions/blueprints/bp_iron_shield.tres" id="p7_gift15"]
[ext_resource type="Resource" path="res://resources/definitions/reagents/ice_essence.tres" id="p7_gift30"]

[sub_resource type="Resource" id="Resource_plate"]
script = ExtResource("1_tpl")
item = ExtResource("2_plate")
weight = 2
max_quantity = 2

[sub_resource type="Resource" id="Resource_tonic"]
script = ExtResource("1_tpl")
item = ExtResource("3_tonic")
weight = 2
max_quantity = 2

[sub_resource type="Resource" id="Resource_ingot"]
script = ExtResource("1_tpl")
item = ExtResource("4_ingot")
min_quantity = 3
max_quantity = 4

[sub_resource type="Resource" id="Resource_loyalty_5"]
script = ExtResource("p7_loyalty")
points = 5
title = "Familiar Face"
gold = 150

[sub_resource type="Resource" id="Resource_loyalty_15"]
script = ExtResource("p7_loyalty")
points = 15
title = "Regular"
blueprint = ExtResource("p7_gift15")

[sub_resource type="Resource" id="Resource_loyalty_30"]
script = ExtResource("p7_loyalty")
points = 30
title = "Old Friend"
gold = 200
reagent = ExtResource("p7_gift30")
reagent_count = 1

[resource]
script = ExtResource("5_cust")
id = "cust_03"
name = "Garrick"
role = "Merchant"
sprite = ExtResource("6_sprite")
min_shop_level = 3
min_orders = 2
max_orders = 3
wants = Array[ExtResource("1_tpl")]([SubResource("Resource_plate"), SubResource("Resource_tonic"), SubResource("Resource_ingot")])
loyalty_rewards = Array[ExtResource("p7_loyalty")]([SubResource("Resource_loyalty_5"), SubResource("Resource_loyalty_15"), SubResource("Resource_loyalty_30")])
