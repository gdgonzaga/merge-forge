[gd_resource type="Resource" script_class="CustomerDefinition" format=3]

[ext_resource type="Script" path="res://resources/definitions/order_template.gd" id="1_tpl"]
[ext_resource type="Resource" path="res://resources/definitions/items/sword.tres" id="2_sword"]
[ext_resource type="Resource" path="res://resources/definitions/items/iron_shield.tres" id="3_shield"]
[ext_resource type="Resource" path="res://resources/definitions/items/flame_sword.tres" id="4_flame"]
[ext_resource type="Script" path="res://resources/definitions/customer_definition.gd" id="5_cust"]
[ext_resource type="Texture2D" path="res://resources/sprites/portraits/customer_09.png" id="6_sprite"]

[ext_resource type="Script" path="res://resources/definitions/loyalty_reward.gd" id="p7_loyalty"]
[ext_resource type="Resource" path="res://resources/definitions/blueprints/bp_frost_blade.tres" id="p7_gift15"]
[ext_resource type="Resource" path="res://resources/definitions/reagents/ice_essence.tres" id="p7_gift30"]
[ext_resource type="Resource" path="res://resources/definitions/items/frost_blade.tres" id="p7_want"]

[sub_resource type="Resource" id="Resource_sword"]
script = ExtResource("1_tpl")
item = ExtResource("2_sword")
weight = 2
max_quantity = 2

[sub_resource type="Resource" id="Resource_shield"]
script = ExtResource("1_tpl")
item = ExtResource("3_shield")
weight = 2

[sub_resource type="Resource" id="Resource_flame"]
script = ExtResource("1_tpl")
item = ExtResource("4_flame")

[sub_resource type="Resource" id="Resource_loyalty_5"]
script = ExtResource("p7_loyalty")
points = 5
title = "Familiar Face"
gold = 250

[sub_resource type="Resource" id="Resource_loyalty_15"]
script = ExtResource("p7_loyalty")
points = 15
title = "Regular"
blueprint = ExtResource("p7_gift15")

[sub_resource type="Resource" id="Resource_loyalty_30"]
script = ExtResource("p7_loyalty")
points = 30
title = "Old Friend"
gold = 200
reagent = ExtResource("p7_gift30")
reagent_count = 1

[sub_resource type="Resource" id="Resource_phase7_want"]
script = ExtResource("1_tpl")
item = ExtResource("p7_want")
max_quantity = 1

[resource]
script = ExtResource("5_cust")
id = "cust_09"
name = "Ser Kaelen"
role = "Knight-Captain"
sprite = ExtResource("6_sprite")
min_shop_level = 14
max_orders = 3
wants = Array[ExtResource("1_tpl")]([SubResource("Resource_sword"), SubResource("Resource_shield"), SubResource("Resource_flame"), SubResource("Resource_phase7_want")])
loyalty_rewards = Array[ExtResource("p7_loyalty")]([SubResource("Resource_loyalty_5"), SubResource("Resource_loyalty_15"), SubResource("Resource_loyalty_30")])
