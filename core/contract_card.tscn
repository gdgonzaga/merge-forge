[gd_scene format=3]

[ext_resource type="Script" path="res://core/contract_card.gd" id="1"]
[ext_resource type="FontFile" path="res://resources/fonts/MedievalSharp-Regular.ttf" id="2_medieval"]
[ext_resource type="FontFile" path="res://resources/fonts/RobotoCondensed-VariableFont_wght.ttf" id="3_roboto"]

[node name="ContractCard" type="PanelContainer"]
size_flags_horizontal = 3
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("2_medieval")
theme_override_font_sizes/font_size = 44
autowrap_mode = 3

[node name="GiverLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("3_roboto")
theme_override_font_sizes/font_size = 32
autowrap_mode = 3

[node name="RequirementsLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("3_roboto")
theme_override_font_sizes/font_size = 40
autowrap_mode = 3

[node name="RewardLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("3_roboto")
theme_override_font_sizes/font_size = 32
autowrap_mode = 3

[node name="SessionsLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("3_roboto")
theme_override_font_sizes/font_size = 32
autowrap_mode = 3

[node name="AcceptBtn" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
theme_override_fonts/font = ExtResource("3_roboto")
theme_override_font_sizes/font_size = 40
