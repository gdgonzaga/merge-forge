[gd_scene format=3]

[ext_resource type="Script" path="res://core/contracts_panel.gd" id="1"]
[ext_resource type="FontFile" path="res://resources/fonts/RobotoCondensed-VariableFont_wght.ttf" id="2_roboto"]

[node name="ContractsPanel" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 24
script = ExtResource("1")

[node name="SlotsLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("2_roboto")
theme_override_font_sizes/font_size = 40

[node name="Offers" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 24

[node name="ActiveTitle" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("2_roboto")
theme_override_font_sizes/font_size = 40
text = "In progress"

[node name="Active" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 24

[node name="EmptyLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("2_roboto")
theme_override_font_sizes/font_size = 36
text = "No contracts on offer. Check again after the next session."
autowrap_mode = 3
