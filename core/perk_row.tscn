[gd_scene format=3]

[ext_resource type="Script" path="res://core/perk_row.gd" id="1_script"]
[ext_resource type="StyleBox" path="res://resources/themes/button_primary.tres" id="2_primary"]
[ext_resource type="StyleBox" path="res://resources/themes/button_primary_pressed.tres" id="3_primary_pressed"]
[ext_resource type="StyleBox" path="res://resources/themes/button_primary_disabled.tres" id="4_primary_disabled"]

[node name="PerkRow" type="PanelContainer"]
size_flags_horizontal = 3
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="HBox" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Info" type="VBoxContainer" parent="Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="NameLabel" type="Label" parent="Margin/HBox/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 40
autowrap_mode = 3

[node name="DescLabel" type="Label" parent="Margin/HBox/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
autowrap_mode = 3

[node name="NextLabel" type="Label" parent="Margin/HBox/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
autowrap_mode = 3

[node name="PickBtn" type="Button" parent="Margin/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 120)
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 32
theme_override_styles/normal = ExtResource("2_primary")
theme_override_styles/pressed = ExtResource("3_primary_pressed")
theme_override_styles/hover = ExtResource("2_primary")
theme_override_styles/disabled = ExtResource("4_primary_disabled")
text = "Pick"
